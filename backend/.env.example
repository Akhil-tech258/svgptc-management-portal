# ==============================================================================
# SVGP Tirupati - Student No-Dues & TC Generator Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Environment: 'development' or 'production'
NODE_ENV=production

# Strong Secret Key for JWT Token Generation (Use a minimum 32-character random string in production)
JWT_SECRET=replace_with_a_secure_random_64_char_hex_key_for_production_2026

# Pre-registered Clerk Administrative Credentials
# (These must match the official administration requirements and will be seeded securely)
CLERK_USERNAME=clerk@svgp
CLERK_PASSWORD=Clerk@1957

# Database Connection URL:
# For Render PostgreSQL, Supabase, or Neon DB:
# DATABASE_URL=postgresql://svgp_db_user:YOUR_STRONG_PASSWORD@dpg-xxxxxx.singapore-postgres.render.com/svgp_db?sslmode=require
# If DATABASE_URL is left empty, SQLite (local database.sqlite) will be used automatically.
DATABASE_URL=
