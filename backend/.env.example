# PostgreSQL Connection String (Supabase / Render / Cloud PostgreSQL):
# In Supabase -> Project Settings -> Database -> Connection string -> Session Pooler (port 5432)
# Format: postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
